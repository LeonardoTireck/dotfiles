# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

zsh_platform=${MYDOTFILES_ZSH_PLATFORM:-$(uname -s)}
case "$zsh_platform" in
  Darwin) zsh_adapter="$HOME/.zshrc.d/macos.zsh" ;;
  Linux) zsh_adapter="$HOME/.zshrc.d/linux.zsh" ;;
  *) zsh_adapter= ;;
esac
if [[ -n "$zsh_adapter" && -r "$zsh_adapter" ]]; then
  source "$zsh_adapter"
fi

alias myip="curl -s https://checkip.amazonaws.com"
alias myhistory="history | awk '{print \$2}' | sort | uniq -c | sort -rn | head -10"
alias reload="source ~/.zshrc"
alias dcup="docker compose up -d"
alias dcdw="docker compose down"
alias dclog="docker compose logs api --since 30s -f"
alias rdflush="docker compose exec redis redis-cli FLUSHALL"
alias npm-major="npm version major --no-git-tag-version"
alias npm-minor="npm version minor --no-git-tag-version"
alias npm-patch="npm version patch --no-git-tag-version"
alias hr="herdr"

if [[ "$zsh_platform" == Darwin ]]; then
  export ZSH="$HOME/.oh-my-zsh"
  export PATH="$HOME/bin:$PATH"
  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  if [[ -s "$NVM_DIR/nvm.sh" ]]; then
    source "$NVM_DIR/nvm.sh"
  fi
  if [[ -s "$NVM_DIR/bash_completion" ]]; then
    source "$NVM_DIR/bash_completion"
  fi
  ZSH_THEME="powerlevel10k/powerlevel10k"
fi
export EDITOR="nvim"

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
if [[ -r "$HOME/.p10k.zsh" ]]; then
  source "$HOME/.p10k.zsh"
fi

if [[ "$zsh_platform" == Linux ]]; then
  export PATH="$HOME/.local/bin:$PATH"
  export PATH="$HOME/.local/bin/Azure.Functions.Cli.linux-x64.4.7.0/:$PATH"
  export PATH="$PATH:/usr/local/go/bin"
fi

export PATH="$HOME/.opencode/bin:$PATH"
