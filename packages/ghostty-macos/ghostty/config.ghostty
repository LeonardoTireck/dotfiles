keybind = "command+r=reload_config"

keybind = "command+up=new_split:up"
keybind = "command+down=new_split:down"
keybind = "command+left=new_split:left"
keybind = "command+right=new_split:right"
keybind = "ctrl+h=goto_split:left"
keybind = "ctrl+j=goto_split:down"
keybind = "ctrl+k=goto_split:up"
keybind = "ctrl+l=goto_split:right"

theme = Nocturnal Winter
# theme = Everforest Light Nvim
# theme = Everforest Light Med
# theme = Gruvbox Dark Hard
# theme = Gruvbox Light

window-decoration = false
background-opacity = 0.98
mouse-hide-while-typing = true

font-size = 22
font-family = JetBrainsMono Nerd Font
# font-family = FiraCode Nerd Font Med 

window-width = 1640
window-height = 510
