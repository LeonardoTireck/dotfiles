thm_cyan="#7fdbca"
thm_black="#011627"
thm_gray="#092236"
thm_magenta="#ae81ff"
thm_pink="#ff2b6d"
thm_red="#f12d52"
thm_green="#09cd7e"
thm_yellow="#f5f17a"
thm_blue="#3182e0"
thm_orange="#f78c6c"
